{
  "name": "frontend-in-motion",
  "version": "1.0.0",
  "private": true,
  "description": "A reusable Remotion educational reel generator for Md Mohiuddin.",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx server/index.ts\"",
    "api": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "studio": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx FrontendInMotionEpisode01 frontend-in-motion-episode-01-fb.mp4",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@remotion/bundler": "^4.0.535",
    "@remotion/cli": "^4.0.0",
    "@remotion/player": "^4.0.535",
    "@remotion/renderer": "^4.0.535",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "concurrently": "^9.2.1"
  }
